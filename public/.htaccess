# ==============================================================================
# RAK 4 CREATIVE - cPanel Apache Configuration (.htaccess)
# ==============================================================================

# Disable directory browsing & multi-views
Options -Indexes -MultiViews

# Default charset & directory index
AddDefaultCharset UTF-8
DirectoryIndex seo.php index.html

# ------------------------------------------------------------------------------
# 1. API ROUTING, SITEMAP, UPLOADS PROTECTION & SERVER-SIDE SEO SPA ROUTING
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization headers to PHP on cPanel CGI/FastCGI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Block direct web access to /api/storage
  RewriteRule ^api/storage(/.*)?$ - [F,L]

  # Dynamic XML Sitemap for Google, Bing & AI Search Crawlers
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Root homepage routes through server-side PHP SEO pre-renderer
  RewriteRule ^$ seo.php [L]

  # Route /api/* requests to the PHP CMS controller
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

  # Serve real files or directories if they exist (including /robots.txt, /og-logo.png, /uploads/*, /assets/*, /seo.php, /api/index.php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite missing static /assets/* files to HTML (prevents MIME mismatch & CDN 404 caching)
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [R=404,L]

  # All SPA routes (/services, /about, /work, /case-studies, /careers, /blog/*, /contact, /admin) route through seo.php
  RewriteRule ^ seo.php [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. MIME TYPES (mod_mime)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript          js mjs
  AddType text/css                        css
  AddType image/svg+xml                   svg svgz
  AddType image/webp                      webp
  AddType video/mp4                       mp4
  AddType font/woff2                      woff2
  AddType font/woff                       woff
  AddType font/ttf                        ttf
  AddType application/json                json
</IfModule>

# ------------------------------------------------------------------------------
# 3. GZIP / BROTLI COMPRESSION (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ------------------------------------------------------------------------------
# 4. BROWSER CACHING (mod_expires & mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & dynamic JSON API responses - Never cache long so CMS updates appear immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # CSS & JS with Vite cache busting hashes
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Media & Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 5. SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to hidden dotfiles (like .git, .env)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
